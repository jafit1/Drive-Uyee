# Local development environment. Gitignored — never commit this file.
# Pada Botkeep, isi variable di Environment; .env tidak ikut di ZIP deploy.

# Password for the drive UI. Anyone who has it controls the Telegram account.
DRIVE_PASSWORD=change-me-to-a-long-random-password

# Signs the session cookie. Keep it stable or every restart logs you out.
DRIVE_SECRET=change-me-to-a-long-random-hex-string

# Path storage persisten Botkeep. Isi path persisten yang ditampilkan panel.
# DATA_DIR=./data

# Botkeep menyuntikkan SERVER_PORT untuk HTTP service.
# SERVER_PORT=3000

# Cache preview/original sementara berada di /tmp, bisa dibangun ulang dari Telegram.
EPHEMERAL_CACHE=1
DISABLE_SHARP=1
CACHE_MAX_BYTES=33554432
CACHE_MAX_AGE_MS=1800000
THUMB_AUTO_BYTES=4194304
PREVIEW_COMPRESS_MAX_BYTES=4194304
FFMPEG_MAX_BYTES=4194304
THUMB_CONCURRENCY=1
TRANSFER_WORKERS=1
SYNC_BATCH=25
MAX_UPLOAD_BYTES=134217728
